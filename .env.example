# Copy to .env.local:  cp .env.example .env.local

# Which data the app uses:
#   mock      → sample creators + a mock signed-in company (no login needed). Good for design work.
#   supabase  → real Supabase data and real login.
NEXT_PUBLIC_DATA_SOURCE=mock

# Public Supabase project settings. The publishable key is safe to expose (it's
# sent to browsers); access is controlled by Row Level Security.
# NEVER put the service-role / secret key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://kwjpvlxnuquphjblydcy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fYKHl_VIz_PJOKABcRddrw_ijaDMXAZ

# Where "Request upgrade" and support links send email.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@conectrz.com

# Stripe (server only — never prefix with NEXT_PUBLIC_). Leave empty to keep the
# "request a plan by email" flow. Use the sandbox key (sk_test_…) until you go live.
# The webhook secret (whsec_…) goes in Supabase → Edge Functions → Secrets, not here.
STRIPE_SECRET_KEY=
